## Docker Compose host port overrides.
## Copy to .env at the repo root (docker compose loads it automatically)
## and set these when another instance of this stack — or another project
## with the same NestJS/Mongo/Next.js layout — is already using the defaults
## on this machine.
##
##   cp .env.example .env
##   # edit the ports below, then:
##   docker compose up

MONGO_PORT=27017
BACKEND_PORT=3001
FRONTEND_PORT=3000

## API key used by the backend service (see backend/.env.example for the
## non-Docker equivalent).
ANTHROPIC_API_KEY=your-api-key-here
